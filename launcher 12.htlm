<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Komore Launcher</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #0b0c10;
            color: #c5c6c7;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .launcher-card {
            background-color: #1f2833;
            width: 100%;
            max-width: 480px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            border: 1px solid #45f3ff33;
        }

        /* En-tête avec le solde de l'utilisateur */
        .header {
            background: linear-gradient(135deg, #1f2833, #0b0c10);
            padding: 25px;
            text-align: center;
            border-bottom: 2px solid #66fcf1;
        }

        .header h1 {
            color: #66fcf1;
            font-size: 24px;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .wallet {
            background-color: rgba(102, 252, 241, 0.1);
            display: inline-block;
            padding: 8px 16px;
            border-radius: 20px;
            border: 1px solid #66fcf1;
            font-weight: bold;
            color: #fff;
        }

        /* Corps du launcher */
        .content {
            padding: 25px;
        }

        /* Section Tournoi */
        .tournament-box {
            background: linear-gradient(135deg, #ff4e50, #f9d423);
            color: #111;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 25px;
            font-weight: bold;
            text-align: center;
            box-shadow: 0 4px 15px rgba(255, 78, 80, 0.4);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.02); }
            100% { transform: scale(1); }
        }

        /* Boutons d'action */
        .btn {
            display: block;
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            text-transform: uppercase;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .btn-play {
            background-color: #66fcf1;
            color: #0b0c10;
            box-shadow: 0 4px 15px rgba(102, 252, 241, 0.3);
        }

        .btn-play:hover {
            background-color: #45b6fe;
            transform: translateY(-2px);
        }

        .btn-discord {
            background-color: #5865F2;
            color: #fff;
            box-shadow: 0 4px 15px rgba(88, 101, 242, 0.3);
        }

        .btn-discord:hover {
            background-color: #4752c4;
            transform: translateY(-2px);
        }

        /* Section Teasing Jeu d'Horreur */
        .upcoming-game {
            background-color: #0b0c10;
            border: 1px solid #ff4e5033;
            border-radius: 8px;
            padding: 15px;
            margin-top: 25px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .game-icon {
            width: 70px;
            height: 70px;
            border-radius: 8px;
            object-fit: cover;
            border: 2px solid #ff4e50;
            box-shadow: 0 0 10px rgba(255, 78, 80, 0.5);
        }

        .game-info {
            flex: 1;
        }

        .game-info h3 {
            color: #ff4e50;
            font-size: 16px;
            margin-bottom: 4px;
            text-transform: uppercase;
        }

        .game-info p {
            font-size: 13px;
            color: #a9a9a9;
        }
    </style>
</head>
<body>

    <div class="launcher-card">
        <!-- En-tête : Nom & Argent -->
        <div class="header">
            <h1>Komore Launcher</h1>
            <div class="wallet">Mon Solde : 0 €</div>
        </div>

        <div class="content">
            <!-- Alerte Tournoi -->
            <div class="tournament-box">
                🏆 TOURNOI DEMAIN !<br>
                100 € À GAGNER !
            </div>

            <!-- Liens de navigation principaux -->
            <a href="https://robloxhack666.github.io/jeux-video-de-Komore-/" target="_blank" class="btn btn-play">Lancer le jeu</a>
            
            <a href="https://discord.gg/c93eSwf4E" target="_blank" class="btn btn-discord">Rejoindre le Discord</a>

            <!-- Section Prochainement -->
            <div class="upcoming-game">
                <img class="game-icon" src="https://images.rtl.fr/~c/770v513/rtl/www/1076707-le-film-d-horreur-annabelle.jpg" alt="Icone Jeu Horreur">
                <div class="game-info">
                    <h3>Prochainement</h3>
                    <p>Un nouveau jeu d'horreur terrifiant arrive bientôt sur la plateforme...</p>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
